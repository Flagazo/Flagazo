# Publicidad. Copiar a `.env` y completar solo si vas a monetizar.
#
# Sin VITE_ADS_CLIENT no se carga ningún script de terceros y los espacios no
# se dibujan: el juego funciona exactamente igual que ahora.
#
# Los ids salen del panel de la red (en AdSense, "Bloques de anuncios").
# OJO: en Vite, todo lo que empieza con VITE_ queda dentro del bundle y es
# público. No poner acá ninguna clave secreta.

# Id de editor. En AdSense tiene la forma ca-pub-0000000000000000
VITE_ADS_CLIENT=

# Id del bloque que va en el lobby, mientras se espera a los amigos
VITE_ADS_SLOT_LOBBY=

# Id del bloque de la pantalla final de la partida
VITE_ADS_SLOT_RESULTS=

# Botón de donar. Acepta cualquier plataforma: pegá el link de tu página de
# cobro (Cafecito, Ko-fi, PayPal.me, Mercado Pago…). Sin esto el botón no
# aparece en ningún lado.
VITE_DONATE_URL=
