{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flagazo-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "flagazo-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "server"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "flagazo-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "client"],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "flagazo-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3001,
      "autoPort": true
    }
  ]
}
