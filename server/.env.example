# Variables del servidor. En producción se cargan en el panel de Render
# (Environment), nunca en el repo. Este archivo es solo la lista.
#
# En desarrollo no hace falta ninguna: base embebida, secreto de desarrollo y
# los emails se muestran en la consola del servidor en vez de enviarse.
# En producción, si falta DATABASE_URL, AUTH_SECRET o RESEND_API_KEY, las
# cuentas quedan apagadas y el juego funciona igual.

# Postgres de las cuentas de usuario. Con Neon tiene esta forma:
#   postgres://usuario:contraseña@ep-algo.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secreto para firmar los códigos de verificación. 32 caracteres aleatorios o más.
# Para generar uno:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Clave de la API de Resend, con permiso "Sending access" solo para flagazo.com.
# Tiene la forma re_xxxxxxxx.
RESEND_API_KEY=

# Opcionales. Remitente (el dominio tiene que estar verificado en Resend) y a
# dónde van las respuestas. Por defecto: Flagazo <flagazo@flagazo.com>.
EMAIL_FROM=
EMAIL_REPLY_TO=

# Dirección pública del sitio, sin barra final. En producción: https://flagazo.com
# En desarrollo se puede dejar vacía (se usa http://localhost:5173).
PUBLIC_URL=

# Huso horario del ranking mensual: decide en qué mes cae una partida jugada cerca
# de la medianoche. Nombre IANA. Vacío = UTC. Ejemplo: America/Argentina/Buenos_Aires
LEADERBOARD_TIMEZONE=

# "Continuar con Google" (Google Cloud Console → Credenciales → ID de cliente de OAuth).
# URL de vuelta a registrar: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Continuar con Discord" (Discord Developer Portal → tu aplicación → OAuth2).
# URL de vuelta a registrar: <PUBLIC_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
